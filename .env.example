# ───────────────────────────────────────────────────────────────
# Black & Red — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# ───────────────────────────────────────────────────────────────

# ── Google Sheets (la misma hoja de la app de Apps Script) ──
# PROD: 1cOoMsXz3P7sARYqxnFqbnR4JRzbpcX06YnuZMI_PaOc
# QA:   1bqxavgFYQnXqt-DLhWrkT401wQC8v_cg0xkZzJ9Uat8
SPREADSHEET_ID=1cOoMsXz3P7sARYqxnFqbnR4JRzbpcX06YnuZMI_PaOc

# Cuenta de servicio de Google Cloud (ver README, sección "Google").
# El private key va entre comillas, con los \n literales tal como
# aparecen en el JSON descargado.
GOOGLE_SERVICE_ACCOUNT_EMAIL=mi-cuenta@mi-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ── Supabase (login) — ver README, sección "Supabase" ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Llave opcional para la pantalla de TV sin login ──
# La TV abre: https://tu-dominio/tv?key=ESTE_VALOR
TV_ACCESS_KEY=

# ── Solo desarrollo: usar datos de ejemplo sin tocar Google Sheets ──
# MOCK_SHEETS=1
